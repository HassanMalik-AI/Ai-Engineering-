## 10. Quick Reference Cheat Sheet

```python
from sklearn.ensemble import RandomForestRegressor

# Minimal usage
rf = RandomForestRegressor(n_estimators=100, random_state=42)
rf.fit(X_train, y_train)
y_pred = rf.predict(X_test)

# Key attributes after fitting
rf.feature_importances_   # array of importance scores
rf.oob_score_             # OOB R² score (set oob_score=True)
rf.estimators_            # list of individual trees
len(rf.estimators_)       # = n_estimators

# Common evaluation
from sklearn.metrics import r2_score, mean_squared_error
r2   = r2_score(y_test, y_pred)
rmse = mean_squared_error(y_test, y_pred, squared=False)

# Hyperparameter tuning with cross-validation
from sklearn.model_selection import GridSearchCV
param_grid = {
    'n_estimators': [50, 100, 200],
    'max_depth': [None, 10, 20],
    'max_features': ['auto', 'sqrt']
}
grid = GridSearchCV(RandomForestRegressor(), param_grid, cv=5, scoring='r2')
grid.fit(X_train, y_train)
print(grid.best_params_)
```

